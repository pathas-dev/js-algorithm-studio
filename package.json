{
  "name": "js-algorithm-studio",
  "version": "0.0.4",
  "description": "외우지 않아도 되는 알고리즘 구경 공간. 한국어·영어로 111개 알고리즘과 자료 구조의 움직임을 탐색합니다.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pathas-dev/js-algorithm-studio.git"
  },
  "keywords": [
    "algorithm-studio",
    "algorithm-visualization",
    "algorithms",
    "data-structures",
    "javascript",
    "typescript",
    "react",
    "education"
  ],
  "author": "pathas-dev",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/pathas-dev/js-algorithm-studio/issues"
  },
  "homepage": "https://github.com/pathas-dev/js-algorithm-studio#readme",
  "scripts": {
    "lint": "biome lint src --error-on-warnings",
    "test": "vitest run --config web/vite.config.mts",
    "coverage": "vitest run --config web/vite.config.mts --coverage",
    "ci": "pnpm lint && pnpm coverage",
    "prepare": "husky",
    "dev": "vite --config web/vite.config.mts",
    "build": "pnpm typecheck && vite build --config web/vite.config.mts",
    "preview": "vite preview --config web/vite.config.mts",
    "typecheck": "tsc --project web/tsconfig.json",
    "check:docs": "node scripts/check-docs.mjs",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react-swc": "4.3.3",
    "@vitest/coverage-istanbul": "5.0.3",
    "husky": "^9.1.7",
    "pngjs": "^7.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=12.10.1"
  },
  "dependencies": {
    "@mantine/core": "9.6.3",
    "@mantine/hooks": "9.6.3",
    "@react-three/fiber": "^9.8.1",
    "motion": "14.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shiki": "4.5.0",
    "three": "^0.186.1"
  },
  "private": true,
  "contributors": [
    "Oleksii Trekhleb (https://trekhleb.dev)"
  ],
  "packageManager": "pnpm@12.10.1"
}
